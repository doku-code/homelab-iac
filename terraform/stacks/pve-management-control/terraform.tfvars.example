# Copy to terraform.tfvars (git-ignored). Values confirmed on 2026-11-14 by `make mgmt-discover`
# (PVE 9.2.26, standalone, i5-10500T 6C/12T, 15.3 GiB RAM) and by the operator.
proxmox_endpoint = "https://192.168.0.10:8006/" # pve-management; TLS verified against its own CA

profile = {
  node            = "pve-management"
  vm_id           = 100 # free on discovery
  name            = "mgmt-control-01"
  image_datastore = "local"     # dir, has the "import" content type
  disk_datastore  = "local-lvm" # lvmthin, ~141 GiB free
  bridge          = "vmbr0"
  ipv4            = "192.168.0.39/24" # static, outside the pfSense DHCP pool (operator)
  gateway         = "192.168.0.1"
  dns_servers     = ["192.168.0.20"] # AdGuard Home
  cores           = 8                # GNOME admin workstation running Claude Code / Codex (ADR-009)
  memory          = 10240            # MiB; ~3.5 GiB left for later management VMs after host overhead
  disk_gb         = 120
  # gpu_mapping   = "igpu"           # host graphics adapter (make mgmt-gpu-mapping); omit for none
}

desktop_iso = {
  # Official Ubuntu Desktop 26.04.1 LTS ISO and its entry in https://releases.ubuntu.com/26.04.1/SHA256SUMS.
  url    = "https://releases.ubuntu.com/26.04.1/ubuntu-26.04.1-desktop-amd64.iso"
  sha256 = "601e30fbf5d97759367c632e2c33630665039b7e2158fd068403da3ccf1bda1f"
}

# Address of the workstation that runs `make mgmt-autoinstall-serve` during an installation.
autoinstall_seed_url = "http://192.168.0.126:8399/"
