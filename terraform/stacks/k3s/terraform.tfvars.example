# Copy to terraform.tfvars (git-ignored). Allocation 2026-11-17 (read-only): 192.168.0.40-45 gave no
# ping/ARP reply; VMIDs 310+ free; pve-lab (.16): 16 threads, ~26 GiB RAM available, 403 GiB empty thin pool.
# 2026-11-18 (read-only): .41 and .42 gave no ping/ARP reply; pve-core 31 GiB RAM with 14 GiB allocated,
# pve-lab 28 GiB with 16 GiB allocated (so the third server gets 6 GiB, not 8).
proxmox_endpoint = "https://192.168.0.10:8006/" # cluster API via pve-management; TLS verified against the cluster CA

nodes = {
  "k3s-server-01" = { node = "pve-lab", vm_id = 310, role = "server", ipv4 = "192.168.0.40/24", cores = 6, memory = 12288, disk_gb = 64 }
  "k3s-server-02" = { node = "pve-core", vm_id = 311, role = "server", ipv4 = "192.168.0.41/24", cores = 4, memory = 8192, disk_gb = 64 }
  # Operator decision 2026-11-18: the third etcd member also runs on pve-lab for now. Losing pve-lab then
  # stops the Kubernetes API (two of three members) until it is back; losing pve-core is tolerated.
  "k3s-server-03" = { node = "pve-lab", vm_id = 312, role = "server", ipv4 = "192.168.0.42/24", cores = 4, memory = 6144, disk_gb = 64 }
}

image = {
  # https://cloud.debian.org/images/cloud/trixie/20261116-2664/SHA512SUMS (same image as deploy-runner-01)
  url    = "https://cloud.debian.org/images/cloud/trixie/20261116-2664/debian-13-genericcloud-amd64-20261116-2664.qcow2"
  sha512 = "37cb32b320820417eb04b335afcf489bfb4cecce4a957190d09cb2bffbe02b56a1cadd62d78c6ead92aa7839d5ea65e4260f994bbb4b54490df59fdf11ee1d97"
}
