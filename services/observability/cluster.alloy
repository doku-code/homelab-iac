// Alloy inside the cluster: container and volume usage from the kubelets, object state from
// kube-state-metrics, pod logs. Only the listed metric names are kept; everything is read once a minute.

prometheus.remote_write "default" {
	external_labels = {cluster = "doku-lab"}

	endpoint {
		url = "http://prometheus-server.monitoring.svc/api/v1/write"
	}
}

loki.write "default" {
	external_labels = {cluster = "doku-lab"}

	endpoint {
		url = "http://loki.monitoring.svc:3100/loki/api/v1/push"
	}
}

discovery.kubernetes "nodes" {
	role = "node"
}

// Kubelets are scraped directly on their own port (10250); the collector's service account may read
// their metrics endpoints and nothing else on them.
discovery.relabel "kubelet" {
	targets = discovery.kubernetes.nodes.targets

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		target_label  = "node"
	}
}

prometheus.scrape "kubelet" {
	targets           = discovery.relabel.kubelet.output
	job_name          = "kubelet"
	metrics_path      = "/metrics"
	scheme            = "https"
	scrape_interval   = "60s"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

	tls_config {
		ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
	}
	forward_to = [prometheus.relabel.kubelet.receiver]
}

prometheus.relabel "kubelet" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "kubelet_volume_stats_(used|capacity|available)_bytes|kubelet_running_pods"
		action        = "keep"
	}
}

prometheus.scrape "cadvisor" {
	targets           = discovery.relabel.kubelet.output
	job_name          = "cadvisor"
	metrics_path      = "/metrics/cadvisor"
	scheme            = "https"
	scrape_interval   = "60s"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

	tls_config {
		ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
	}
	forward_to = [prometheus.relabel.cadvisor.receiver]
}

prometheus.relabel "cadvisor" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "container_cpu_usage_seconds_total|container_memory_working_set_bytes|container_network_(receive|transmit)_bytes_total|container_cpu_cfs_throttled_periods_total|container_oom_events_total"
		action        = "keep"
	}

	// Pods only: system slices and the node totals are covered by the host collectors.
	rule {
		source_labels = ["pod"]
		regex         = ""
		action        = "drop"
	}

	rule {
		regex  = "id|name|image"
		action = "labeldrop"
	}
}

prometheus.scrape "kube_state_metrics" {
	targets         = [{"__address__" = "prometheus-kube-state-metrics.monitoring.svc:8080"}]
	job_name        = "kube-state-metrics"
	scrape_interval = "60s"
	forward_to      = [prometheus.remote_write.default.receiver]
}

discovery.kubernetes "pods" {
	role = "pod"
}

discovery.relabel "pod_logs" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		target_label = "job"
		replacement  = "pods"
	}
}

loki.source.kubernetes "pods" {
	targets    = discovery.relabel.pod_logs.output
	forward_to = [loki.relabel.pods.receiver]
}

// The source adds instance="namespace/pod:container", which repeats the three labels above.
loki.relabel "pods" {
	forward_to = [loki.write.default.receiver]

	rule {
		regex  = "instance"
		action = "labeldrop"
	}
}
