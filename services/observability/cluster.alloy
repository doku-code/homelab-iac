// Alloy inside the cluster: container and volume usage from the kubelets, object state from
// kube-state-metrics, pod logs, and the port counters of the switch. Only the listed metric names are kept;
// everything is read once a minute, the switch every 15 seconds (see below).

prometheus.remote_write "default" {
	external_labels = {cluster = "doku-lab"}

	endpoint {
		url = "http://victoria-metrics.monitoring.svc:8428/api/v1/write"
	}
}

loki.write "default" {
	external_labels = {cluster = "doku-lab"}

	endpoint {
		url = "http://loki.monitoring.svc:3100/loki/api/v1/push"
	}
}

discovery.kubernetes "nodes" {
	role = "node"
}

// Kubelets are scraped directly on their own port (10250); the collector's service account may read
// their metrics endpoints and nothing else on them.
discovery.relabel "kubelet" {
	targets = discovery.kubernetes.nodes.targets

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		target_label  = "node"
	}
}

prometheus.scrape "kubelet" {
	targets           = discovery.relabel.kubelet.output
	job_name          = "kubelet"
	metrics_path      = "/metrics"
	scheme            = "https"
	scrape_interval   = "60s"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

	tls_config {
		ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
	}
	forward_to = [prometheus.relabel.kubelet.receiver]
}

prometheus.relabel "kubelet" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "kubelet_volume_stats_(used|capacity|available)_bytes|kubelet_running_pods"
		action        = "keep"
	}
}

prometheus.scrape "cadvisor" {
	targets           = discovery.relabel.kubelet.output
	job_name          = "cadvisor"
	metrics_path      = "/metrics/cadvisor"
	scheme            = "https"
	scrape_interval   = "60s"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

	tls_config {
		ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
	}
	forward_to = [prometheus.relabel.cadvisor.receiver]
}

prometheus.relabel "cadvisor" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "container_cpu_usage_seconds_total|container_memory_working_set_bytes|container_network_(receive|transmit)_bytes_total|container_cpu_cfs_throttled_periods_total|container_oom_events_total"
		action        = "keep"
	}

	// Pods only: system slices and the node totals are covered by the host collectors.
	rule {
		source_labels = ["pod"]
		regex         = ""
		action        = "drop"
	}

	rule {
		regex  = "id|name|image"
		action = "labeldrop"
	}
}

prometheus.scrape "kube_state_metrics" {
	targets         = [{"__address__" = "kube-state-metrics.monitoring.svc:8080"}]
	job_name        = "kube-state-metrics"
	scrape_interval = "60s"
	forward_to      = [prometheus.remote_write.default.receiver]
}

// The switch (QNAP QSW-M3216R-8S8T, 192.168.0.3) over SNMPv3: state, bytes, frames, errors and discards of each
// port. snmp.yml says what is asked; the sign-in comes from the Secret switch-snmp. The switch only has 32-bit
// byte counters, which wrap after 4 GiB: read every 15 seconds they stay correct up to about 2.3 Gbit/s.
prometheus.exporter.snmp "switch" {
	config_files = ["/etc/alloy/snmp.yml", "/etc/alloy-snmp/auth.yml"]

	target "switch" {
		address = "192.168.0.3"
		module  = "qsw_if"
		auth    = "switch_v3"
	}
}

prometheus.scrape "switch" {
	targets         = prometheus.exporter.snmp.switch.targets
	scrape_interval = "15s"
	scrape_timeout  = "12s"
	forward_to      = [prometheus.relabel.switch.receiver]
}

prometheus.relabel "switch" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "up|sysUpTime|ifOperStatus|ifSpeed|if(In|Out)(Octets|UcastPkts|Discards|Errors)"
		action        = "keep"
	}

	// Ports 1 to 16 only: the aggregates and the management interface (17 to 33) carry nothing of their own.
	rule {
		source_labels = ["ifIndex"]
		regex         = "1[7-9]|2[0-9]|3[0-9]"
		action        = "drop"
	}

	rule {
		target_label = "job"
		replacement  = "switch"
	}

	rule {
		target_label = "instance"
		replacement  = "switch"
	}
}

// TrueNAS (192.168.0.13): it pushes its metrics to the Graphite exporter of truenas.yaml; the second exporter
// asks its API for the pools, the disks' temperatures, the apps and the alerts. Only the NAS's own metrics are
// kept, not what the two exporters say about themselves.
prometheus.scrape "truenas" {
	targets = [
		{"__address__" = "truenas-graphite.monitoring.svc:9108", "instance" = "truenas", "source" = "graphite"},
		{"__address__" = "truenas-exporter.monitoring.svc:9110", "instance" = "truenas", "source" = "api"},
	]
	job_name        = "truenas"
	scrape_interval = "60s"
	forward_to      = [prometheus.relabel.truenas.receiver]
}

prometheus.relabel "truenas" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "up|truenas_.+"
		action        = "keep"
	}
}

// pfSense (192.168.0.1): the node_exporter package the operator enabled on its LAN side (2026-11-27). Read only;
// nothing on pfSense is configured from this repository. Interfaces, processor, memory and the exporter's state.
prometheus.scrape "pfsense" {
	targets         = [{"__address__" = "192.168.0.1:9100", "instance" = "pfsense"}]
	job_name        = "pfsense"
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.pfsense.receiver]
}

prometheus.relabel "pfsense" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "up|node_(network|cpu|memory|load|boot_time|uname|filesystem)_.+|node_load\\d+"
		action        = "keep"
	}
}

discovery.kubernetes "pods" {
	role = "pod"
}

discovery.relabel "pod_logs" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		target_label = "job"
		replacement  = "pods"
	}
}

loki.source.kubernetes "pods" {
	targets    = discovery.relabel.pod_logs.output
	forward_to = [loki.relabel.pods.receiver]
}

// The source adds instance="namespace/pod:container", which repeats the three labels above.
loki.relabel "pods" {
	forward_to = [loki.write.default.receiver]

	rule {
		regex  = "instance"
		action = "labeldrop"
	}
}
