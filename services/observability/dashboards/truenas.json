    {
      "id": 8,
      "type": "bargauge",
      "title": "Pools: space written",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * truenas_pool_allocated_bytes{job=\"truenas\"} / truenas_pool_size_bytes{job=\"truenas\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{pool}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "description": "ZFS slows down as a pool fills: 80 % is the usual line to stay under."
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Datasets: space used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
