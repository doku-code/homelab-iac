          "refId": "A",
          "expr": "truenas_cpu_usage_percent{job=\"truenas\",cpu=\"\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "all cores"
        },
        {
          "refId": "B",
          "expr": "truenas_cpu_usage_percent{job=\"truenas\",cpu!=\"\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "core {{cpu}}"
        }
