    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Errors and drops on the WAN port",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_errs_total{job=\"pfsense\",device=\"re0\"}[5m]) + rate(node_network_transmit_errs_total{job=\"pfsense\",device=\"re0\"}[5m])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "errors"
        },
        {
          "refId": "B",
          "expr": "rate(node_network_receive_drop_total{job=\"pfsense\",device=\"re0\"}[5m]) + rate(node_network_transmit_drop_total{job=\"pfsense\",device=\"re0\"}[5m])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "drops"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
