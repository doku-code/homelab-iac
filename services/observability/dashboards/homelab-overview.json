    {
      "id": 21,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      }
    },
    {
      "id": 22,
      "type": "logs",
      "title": "Host errors (journal, priority error and above)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"journal\", level=~\"err|crit|alert|emerg\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 23,
      "type": "logs",
      "title": "Pod errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"pods\"} |~ \"level=(error|fatal|panic)|\\\"level\\\":\\\\s*\\\"(error|fatal|critical|panic)\\\"|\\\\b(ERR|ERROR|FATAL|PANIC)\\\\b|^E[0-9]{4} |panic:\" !~ \"context canceled\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "description": "Lines whose level is error or worse (level field, upper-case level word, klog E-line, Go panic). Requests the client abandoned are left out."
    }
  ]
}
