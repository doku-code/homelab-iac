          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Rollbacks and deadlocks",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_rollback{datname!~\"template.*|\"}[5m]) * on(instance) group_left() (patroni_primary == 1) > 0",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{datname}} rollbacks/s"
        },
        {
          "refId": "B",
          "expr": "increase(pg_stat_database_deadlocks[1h]) * on(instance) group_left() (patroni_primary == 1) > 0",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{datname}} deadlocks in 1 h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Reads answered from memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "description": "Share of block reads found in PostgreSQL's cache. Low for long means the memory is too small for that database.",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(pg_stat_database_blks_hit{datname!~\"template.*|\"}[10m]) / (rate(pg_stat_database_blks_hit{datname!~\"template.*|\"}[10m]) + rate(pg_stat_database_blks_read{datname!~\"template.*|\"}[10m]) > 0) * on(instance) group_left() (patroni_primary == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
