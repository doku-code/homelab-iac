    {
      "id": 9,
      "type": "timeseries",
      "title": "How far each standby is behind",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "description": "Bytes the leader has written and the standby has not replayed yet.",
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(scalar(max(patroni_xlog_location and on(name) (patroni_primary == 1))) - (patroni_xlog_replayed_location and on(name) (patroni_primary == 0)), 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Timeline",
      "datasource": {
        "type": "prometheus",
