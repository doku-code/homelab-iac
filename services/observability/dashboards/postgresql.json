        "x": 12,
        "y": 15
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{datname!~\"template.*|\"}[5m]) * on(instance) group_left() (patroni_primary == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{datname}}"
        }
