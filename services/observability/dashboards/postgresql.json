        "w": 4,
        "x": 16,
        "y": 1
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(pg_stat_database_numbackends * on(instance) group_left() (patroni_primary == 1)) / max(pg_settings_max_connections)",
