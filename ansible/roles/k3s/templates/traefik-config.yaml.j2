# Managed by Ansible (role k3s). Customises the bundled Traefik without replacing it.
# externalTrafficPolicy Local keeps the client address, so ingress allow-lists (admin LAN) work. It also
# means a node answers only when Traefik runs on that node: with several nodes Traefik is a DaemonSet, so
# the published names (the shared address, kube-vip.yaml) keep working whichever server holds it.
# Traefik gives a request 60 seconds to arrive in full, body included: a large Git push, an image layer or a
# Nextcloud upload over a slow link was cut with a 502 (measured 2026-11-23). Thirty minutes instead.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    deployment:
      kind: DaemonSet
    service:
      spec:
        externalTrafficPolicy: Local
{% if k3s_vip %}
        # The shared address is one of the Service's own: kube-proxy answers on it directly and the client
        # address survives. Through ServiceLB's host port alone, Traefik saw a pod address (403 on LAN-only names).
        externalIPs:
          - {{ k3s_vip }}
{% endif %}
    ports:
      websecure:
        transport:
          respondingTimeouts:
            readTimeout: 1800s
