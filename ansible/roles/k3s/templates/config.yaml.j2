# Managed by Ansible (role k3s). Holds the cluster token: root 0600.
node-name: {{ inventory_hostname }}
node-ip: {{ ansible_host }}
token: {{ k3s_token }}
{% if k3s_role == 'server' %}
{% if inventory_hostname == k3s_init_node %}
cluster-init: true
{% else %}
server: {{ k3s_api_url }}
{% endif %}
tls-san:
  - {{ ansible_host }}
{% if k3s_vip %}
  - {{ k3s_vip }}
{% endif %}
cluster-cidr: {{ k3s_cluster_cidr }}
service-cidr: {{ k3s_service_cidr }}
write-kubeconfig-mode: "0600"
{% if k3s_oidc_issuer %}
kube-apiserver-arg:
  - "oidc-issuer-url={{ k3s_oidc_issuer }}"
  - "oidc-client-id={{ k3s_oidc_client_id }}"
  - "oidc-username-claim=preferred_username"
  - "oidc-username-prefix={{ k3s_oidc_prefix }}"
  - "oidc-groups-claim=groups"
  - "oidc-groups-prefix={{ k3s_oidc_prefix }}"
{% endif %}
{% if k3s_disable %}
disable:
{% for item in k3s_disable %}
  - {{ item }}
{% endfor %}
{% endif %}
{% else %}
server: {{ k3s_api_url }}
{% endif %}
