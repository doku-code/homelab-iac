# Managed by Ansible (role media_service). Read by {{ media_service }}.service; root only.
{% set p = media_service | upper %}
TZ={{ media_timezone }}
{{ p }}__POSTGRES__HOST={{ media_postgresql_host }}
{{ p }}__POSTGRES__PORT={{ media_postgresql_port }}
{{ p }}__POSTGRES__USER={{ media_service }}
{{ p }}__POSTGRES__PASSWORD={{ media_database_passwords[media_service] }}
{{ p }}__POSTGRES__MAINDB={{ media_service }}
{{ p }}__POSTGRES__LOGDB={{ media_service }}_log
{{ p }}__AUTH__APIKEY={{ media_api_keys[media_service] }}
# The application's own sign-in stays (administrator in the secret store); it is not asked from private
# addresses, because the only way in from the network is Traefik after Authentik (firewall of the container).
{{ p }}__AUTH__METHOD=Forms
{{ p }}__AUTH__REQUIRED=DisabledForLocalAddresses
{{ p }}__SERVER__URLBASE=/{{ media_service }}
{{ p }}__SERVER__PORT={{ media_ports[media_service] }}
{{ p }}__LOG__ANALYTICSENABLED=False
# Versions change in ansible/vars/media.yml, not from the application's own updater.
{{ p }}__UPDATE__AUTOMATICALLY=False
{{ p }}__UPDATE__MECHANISM=External
