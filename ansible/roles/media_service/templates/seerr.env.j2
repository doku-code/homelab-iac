# Managed by Ansible (role media_service). Read by seerr.service; root only.
TZ={{ media_timezone }}
NODE_ENV=production
HOST=0.0.0.0
PORT={{ media_ports.seerr }}
LOG_LEVEL=info
CONFIG_DIRECTORY=/var/lib/seerr
API_KEY={{ media_api_keys.seerr }}
DB_TYPE=postgres
DB_HOST={{ media_postgresql_host }}
DB_PORT={{ media_postgresql_port }}
DB_USER=seerr
DB_PASS={{ media_database_passwords.seerr }}
DB_NAME=seerr
# The members present a self-signed certificate: encrypted, like every application of the platform.
DB_USE_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
