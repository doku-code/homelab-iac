#!/usr/bin/env bash
set -euo pipefail

VMID="${1:?missing VMID}"
PHASE="${2:?missing phase}"

SHUTDOWN_TIMEOUT={{ pve_workstation_shutdown_timeout }}

if [[ "${PHASE}" != "pre-start" ]]; then
    exit 0
fi

exec 9>/run/lock/pve-workstation-exclusive.lock
flock -x 9

mapfile -t WORKSTATION_IDS < <(
    qm list |
    awk 'NR > 1 { print $1 }' |
    while read -r id; do
        tags="$(
            qm config "${id}" |
            awk -F': ' '$1 == "tags" { print $2 }'
        )"

        case ";${tags};" in
            *";workstation;"*)
                echo "${id}"
                ;;
        esac
    done
)

echo "WORKSTATION POOL: preparing VM ${VMID}"

for OTHER in "${WORKSTATION_IDS[@]}"; do
    [[ "${OTHER}" == "${VMID}" ]] && continue

    STATUS="$(qm status "${OTHER}" | awk '{ print $2 }')"

    if [[ "${STATUS}" != "running" ]]; then
        continue
    fi

    echo "WORKSTATION POOL: VM ${OTHER} is running."
    echo "WORKSTATION POOL: requesting graceful shutdown."

    if ! qm shutdown "${OTHER}" --timeout "${SHUTDOWN_TIMEOUT}"; then
        echo "WORKSTATION POOL: graceful shutdown failed." >&2
        echo "WORKSTATION POOL: refusing to start VM ${VMID}." >&2
        exit 1
    fi

    DEADLINE=$((SECONDS + SHUTDOWN_TIMEOUT))

    while [[ "$(qm status "${OTHER}" | awk '{ print $2 }')" != "stopped" ]]; do
        if (( SECONDS >= DEADLINE )); then
            echo "WORKSTATION POOL: VM ${OTHER} is still running." >&2
            echo "WORKSTATION POOL: refusing to start VM ${VMID}." >&2
            exit 1
        fi

        sleep 2
    done

    echo "WORKSTATION POOL: VM ${OTHER} stopped."
done

echo "WORKSTATION POOL: hardware available for VM ${VMID}."
exit 0
