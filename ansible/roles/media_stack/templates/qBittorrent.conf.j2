[BitTorrent]
Session\DefaultSavePath=/data/torrents
Session\TempPathEnabled=false
Session\Port=6881
Session\QueueingSystemEnabled=true
Session\MaxActiveDownloads=3
Session\MaxActiveTorrents=10
Session\MaxActiveUploads=5

[LegalNotice]
Accepted=true

[Preferences]
General\Locale=en
WebUI\Port=8080
WebUI\Username={{ media_admin_user }}
WebUI\Password_PBKDF2="@ByteArray({{ media_qbittorrent_hash }})"
WebUI\LocalHostAuth=true
WebUI\AuthSubnetWhitelistEnabled=true
WebUI\AuthSubnetWhitelist={{ media_ingress_sources | join(', ') }}
WebUI\HostHeaderValidation=false
WebUI\CSRFProtection=true
WebUI\ClickjackingProtection=true
