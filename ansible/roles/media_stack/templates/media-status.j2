#!/usr/bin/env bash
# Managed by Ansible (role media_stack). Read-only summary for `make media-status`; prints no secret.
set -uo pipefail
cd {{ media_project_dir }}

echo "== containers"
docker compose ps --format 'table {{ '{{.Service}}\t{{.State}}\t{{.Status}}' }}'

echo "== health answers"
check() { printf '%-12s %s\n' "$1" "$(curl -s -o /dev/null -m 5 -w '%{http_code}' "$2")"; }
check jellyfin http://127.0.0.1:8096/health
check seerr http://127.0.0.1:5055/api/v1/status
{% for app in media_arr_apps %}
check {{ app.name }} http://127.0.0.1:{{ app.port }}/{{ app.name }}/ping
{% endfor %}
check qbittorrent http://127.0.0.1:8080/

echo "== storage"
findmnt -n -o TARGET,SOURCE,FSTYPE,OPTIONS {{ media_root }} || echo "{{ media_root }}: NOT MOUNTED"
df -h --output=size,used,avail,pcent {{ media_root }} | tail -n 1
{% if media_nas_export %}
echo "NAS library as Jellyfin sees it ({{ media_nas_server }}:{{ media_nas_export }}):"
docker compose exec -T jellyfin sh -c 'grep " /data/nas " /proc/mounts | cut -d" " -f1-4; ls /data/nas | head -n 5; touch /data/nas/.write-test 2>&1 | head -n 1'
{% else %}
echo "NAS library: not configured (media_nas_export is empty in ansible/vars/media.yml)"
{% endif %}

echo "== databases (shared PostgreSQL {{ media_postgresql_host }}, TLS)"
set -a; . {{ media_project_dir }}/.env; set +a
for pair in seerr:seerr radarr:radarr radarr:radarr_log sonarr:sonarr sonarr:sonarr_log prowlarr:prowlarr prowlarr:prowlarr_log; do
  role="${pair%%:*}"; database="${pair##*:}"; variable="PG_APP_${role^^}_PASSWORD"
  PGPASSWORD="${!variable}" PGSSLMODE=require PGCONNECT_TIMEOUT=5 psql -h {{ media_postgresql_host }} -U "$role" -d "$database" -Atc \
    "select current_database() || ': ' || count(*) || ' tables, ' || pg_size_pretty(pg_database_size(current_database())) || ', tls ' || (select ssl from pg_stat_ssl where pid = pg_backend_pid()) from information_schema.tables where table_schema = 'public'" 2>&1 | head -n 1
done

echo "== graphics adapter"
{% if media_gpu %}
ls -l {{ media_gpu_render_device }} 2>&1
dmesg 2>/dev/null | grep -i -E "i915.*(GuC|HuC)" | tail -n 3
docker compose exec -T jellyfin /usr/lib/jellyfin-ffmpeg/vainfo --display drm --device {{ media_gpu_render_device }} 2>&1 | grep -E "Driver version|VAEntrypointEnc" | head -n 12
{% else %}
echo "none handed to the VM (gpu_mapping is null in terraform/stacks/media/terraform.tfvars): software transcoding"
{% endif %}

echo "== last archive"
ls -1t {{ media_root }}/backups 2>/dev/null | head -n 1
