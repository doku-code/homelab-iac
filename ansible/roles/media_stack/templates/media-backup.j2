#!/usr/bin/env bash
# Managed by Ansible (role media_stack). One archive per run in {{ media_root }}/backups, {{ media_backup_keep }} kept:
#   - every application's configuration directory (without caches, logs and what Jellyfin can download again),
#   - a consistent copy of each SQLite database (Jellyfin, and qBittorrent has none),
#   - a pg_dump of each database on the shared PostgreSQL (the Arr tools do not back those up themselves).
# The archive holds API keys and password hashes: root only. It stays on this disk until copied elsewhere
# (`make media-backup` copies the newest one to the workstation).
set -euo pipefail
umask 077

root={{ media_root }}
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
stage="$(mktemp -d "$root/backups/.stage-XXXXXX")"
trap 'rm -rf -- "$stage"' EXIT

set -a; . {{ media_project_dir }}/.env; set +a
mkdir "$stage/postgresql" "$stage/sqlite"
for pair in seerr:seerr radarr:radarr radarr:radarr_log sonarr:sonarr sonarr:sonarr_log prowlarr:prowlarr prowlarr:prowlarr_log; do
  role="${pair%%:*}"; database="${pair##*:}"; variable="PG_APP_${role^^}_PASSWORD"
  PGPASSWORD="${!variable}" PGSSLMODE=require pg_dump -h {{ media_postgresql_host }} -U "$role" -d "$database" \
    --format=custom --no-owner --file "$stage/postgresql/$database.dump"
done

# SQLite: the online backup API gives a consistent copy while the application runs.
while IFS= read -r -d '' database; do
  name="$(printf '%s' "${database#"$root/config/"}" | tr '/' '_')"
  sqlite3 "file:$database?mode=ro" ".backup '$stage/sqlite/$name'"
done < <(find "$root/config" -type f \( -name '*.db' -o -name '*.sqlite3' \) -not -path '*/Backups/*' -print0)

cp {{ media_project_dir }}/compose.yml "$stage/compose.yml"
tar --create --zstd --file "$root/backups/media-$stamp.tar.zst" \
  --exclude='*.db' --exclude='*.db-wal' --exclude='*.db-shm' --exclude='*.sqlite3' \
  --exclude='jellyfin/data/metadata' --exclude='jellyfin/metadata' --exclude='jellyfin/log' --exclude='jellyfin/data/transcodes' \
  --exclude='logs' --exclude='MediaCover' --exclude='Backups' --exclude='qbittorrent/qBittorrent/cache' \
  -C "$stage" postgresql sqlite compose.yml -C "$root" config

ls -1t "$root/backups"/media-*.tar.zst | tail -n +$(( {{ media_backup_keep }} + 1 )) | while IFS= read -r old; do rm -f -- "$old"; done
echo "archive: $root/backups/media-$stamp.tar.zst ($(du -h "$root/backups/media-$stamp.tar.zst" | cut -f1))"
